# local state of the goal loop
.synapse/

# environments and dependencies
.venv/
__pycache__/
node_modules/
.next/
out/
# measured results the pitch may quote (yawn calibration, G2 metrics) are versioned; smoke runs are not
!data/out/
data/out/smoke/
frontend/test-results/
frontend/playwright-report/

# datasets and heavy models: downloaded with make prefetch or by hand (docs/PREP.md)
data/raw/
data/features/
*.part
frontend/public/mediapipe/wasm/
frontend/public/mediapipe/*.task
backend/assets/voices/

# secrets
.env

# per-developer preview servers for the Claude desktop app
.claude/launch.json

# NASA raw downloads (research/nasa-data/fetch.sh) and OS clutter
research/nasa-data/raw/
.DS_Store

# G1 fixtures: the raw .y4m Chromium plays is ~120 MB; rebuild it from the .mp4 with data/fixtures/record.sh convert
data/fixtures/*.y4m
# The .mp4 sources are faces and the repository goes public: kept out unless the team decides to publish them
data/fixtures/*.mp4
